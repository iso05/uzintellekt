# ─── OneID OAuth 2.0 Configuration ───────────────────────────
# Client ID from OneID portal
VITE_ONEID_CLIENT_ID=uzintellekt_uz

# Authorized redirect URI — OneID sends user here after auth
# dashboard.uzintellekt.uz handles the ?code= callback itself
VITE_ONEID_REDIRECT_URI=https://dashboard.uzintellekt.uz

# ─── Dashboard (external domain) ─────────────────────────────
VITE_DASHBOARD_URL=https://dashboard.uzintellekt.uz

# ─── Backend API ──────────────────────────────────────────────
VITE_API_BASE_URL=https://api.uzintellekt.uz

# Environment
VITE_ENVIRONMENT=production
