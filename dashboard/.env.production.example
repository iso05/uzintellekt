# ──────────────────────────────────────────────────────────────────
# Production env template. Copy to `.env.production` and fill in
# real values before running `npm run build`.
#
# Vite reads .env.production automatically when NODE_ENV=production
# (which `vite build` sets by default).
# ──────────────────────────────────────────────────────────────────

# Test mode MUST be off in production.
VITE_TEST_MODE=false

# Production backend base URL (no trailing slash).
VITE_API_BASE_URL=https://api.uzintellekt.uz

# Main site URL used for logout/register/blocked redirects.
VITE_MAIN_SITE_URL=https://uzintellekt.uz
